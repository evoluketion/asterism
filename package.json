{
  "name": "asterism",
  "productName": "Asterism",
  "version": "0.1.0",
  "description": "Tiled terminal wrapper built for running many Claude Code sessions at once",
  "main": "src/main/main.js",
  "license": "UNLICENSED",
  "private": true,
  "scripts": {
    "start": "electron .",
    "test": "node --test test/*.test.js test/*.test.mjs",
    "rebuild": "electron-rebuild -f -w node-pty",
    "postinstall": "node scripts/postinstall.js",
    "icon": "electron scripts/render-icon.js",
    "dist:linux": "electron-builder --linux AppImage --publish never",
    "dist:win": "electron-builder --win nsis --publish never"
  },
  "dependencies": {
    "@xterm/addon-fit": "0.11.0",
    "@xterm/addon-search": "0.16.0",
    "@xterm/addon-web-links": "0.12.0",
    "@xterm/addon-webgl": "0.19.0",
    "@xterm/xterm": "6.0.0",
    "node-pty": "1.1.0"
  },
  "devDependencies": {
    "@electron/rebuild": "4.2.0",
    "electron": "44.9.3",
    "electron-builder": "26.17.0"
  },
  "build": {
    "appId": "dev.local.asterism",
    "productName": "Asterism",
    "files": [
      "src/**/*",
      "package.json"
    ],
    "asarUnpack": [
      "node_modules/node-pty/**"
    ],
    "linux": {
      "target": "AppImage",
      "category": "Development",
      "icon": "build/icon.png",
      "executableName": "asterism",
      "syncDesktopName": true,
      "desktop": {
        "entry": {
          "Name": "Asterism",
          "Comment": "Tiled terminal for running many Claude Code sessions",
          "StartupWMClass": "asterism"
        }
      },
      "artifactName": "${productName}-${version}.${ext}"
    },
    "win": {
      "target": "nsis",
      "icon": "build/icon.png"
    },
    "nsis": {
      "artifactName": "${productName}-${version}-Setup.${ext}"
    }
  },
  "desktopName": "asterism.desktop"
}
